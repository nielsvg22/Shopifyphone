{%- liquid
  assign coll = collections[section.settings.collection]
-%}
<section class="featured-collection">
  <div class="container">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      {%- if coll -%}<a href="{{ coll.url }}" class="section-heading__link">Bekijk alles {% render 'icon', name: 'chevron-right' %}</a>{%- endif -%}
    </div>

    {%- if coll and coll.products.size > 0 -%}
      <div class="product-grid product-grid--4">
        {%- for product in coll.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty-state">Selecteer een collectie in de theme editor om producten te tonen.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Uitgelichte collectie",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Nieuw binnen" },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "products_to_show", "label": "Aantal producten", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Uitgelichte collectie" }]
}
{% endschema %}
