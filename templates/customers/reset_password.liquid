<section class="main-page main-page--narrow">
  <div class="container">
    <h1>Nieuw wachtwoord instellen</h1>
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label for="reset_password">Nieuw wachtwoord</label>
      <input type="password" name="customer[password]" id="reset_password" autocomplete="new-password" required>
      <label for="reset_password_confirmation">Bevestig wachtwoord</label>
      <input type="password" name="customer[password_confirmation]" id="reset_password_confirmation" autocomplete="new-password" required>
      <button type="submit" class="btn btn--cta btn--full">Wachtwoord instellen</button>
    {% endform %}
  </div>
</section>
