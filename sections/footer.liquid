<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col site-footer__brand">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="140" loading="lazy">
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
      {%- if section.settings.show_payment_icons -%}
        <ul class="site-footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'link_list' -%}
          <div class="site-footer__col">
            <h3>{{ block.settings.heading }}</h3>
            {%- assign fm = linklists[block.settings.menu] -%}
            {%- if fm -%}
            <ul>
              {%- for link in fm.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
            {%- endif -%}
          </div>
        {%- when 'contact' -%}
          <div class="site-footer__col">
            <h3>{{ block.settings.heading }}</h3>
            <ul class="site-footer__contact">
              {%- if block.settings.phone != blank -%}<li><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></li>{%- endif -%}
              {%- if block.settings.email != blank -%}<li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>{%- endif -%}
              {%- if block.settings.address != blank -%}<li>{{ block.settings.address }}</li>{%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_text }}</p>
    {%- if section.settings.show_social -%}
      <ul class="site-footer__social">
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">Instagram</a></li>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">Facebook</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">TikTok</a></li>{%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Beschrijving", "default": "Premium pre-owned Apple-producten, gecontroleerd en gegarandeerd." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Toon betaalmethoden", "default": true },
    { "type": "checkbox", "id": "show_social", "label": "Toon social links", "default": true },
    { "type": "text", "id": "legal_text", "label": "Juridische tekst", "default": "Alle rechten voorbehouden." }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Linkkolom",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Informatie" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Contact" },
        { "type": "text", "id": "phone", "label": "Telefoon" },
        { "type": "text", "id": "email", "label": "E-mail" },
        { "type": "textarea", "id": "address", "label": "Adres" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Informatie" } },
      { "type": "link_list", "settings": { "heading": "Klantenservice" } },
      { "type": "contact", "settings": { "heading": "Contact" } }
    ]
  }
}
{% endschema %}
