<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }} cadeaubon</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="gift-card">
  <div class="container gift-card__inner">
    <h1>Cadeaubon</h1>
    <p class="gift-card__amount">{{ gift_card.balance | money }}</p>
    <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
    {%- if gift_card.expired -%}<p>Deze cadeaubon is verlopen.</p>{%- endif -%}
  </div>
</body>
</html>
