<section class="main-page">
  <div class="container">
    <h1>{{ blog.title }}</h1>
    <div class="category-grid__grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="category-card">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title }}" width="350" height="350" loading="lazy">
          {%- endif -%}
          <span class="category-card__title">{{ article.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
