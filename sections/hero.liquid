<section class="hero">
  {%- if section.settings.image -%}
    <img class="hero__image" src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
      sizes="100vw" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="eager" fetchpriority="high">
  {%- endif -%}
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="hero__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--cta btn--lg">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Achtergrondafbeelding" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Premium pre-owned Apple-producten" },
    { "type": "text", "id": "subheading", "label": "Subtitel", "default": "Gecontroleerd, gegarandeerd en scherp geprijsd." },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Bekijk de voorraad" },
    { "type": "url", "id": "button_link", "label": "Knoplink" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
