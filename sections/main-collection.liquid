{%- paginate collection.products by 24 -%}
<section class="main-collection">
  <div class="container">
    <div class="collection-header">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
      <p class="collection-header__count">{{ collection.products_count }} producten</p>
    </div>

    <div class="collection-layout">
      <aside class="collection-filters" data-filters>
        <button class="collection-filters__mobile-toggle" data-filters-toggle>Filters {% render 'icon', name: 'chevron-down' %}</button>
        <form id="collection-filter-form" data-filter-form>
          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <h3>{{ filter.label }}</h3>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul>
                    {%- for value in filter.values -%}
                      <li>
                        <label class="{% if value.count == 0 %}is-disabled{% endif %}">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} onchange="document.getElementById('collection-filter-form').submit()">
                          {{ value.label }} ({{ value.count }})
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filter-price">
                    <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Min €" value="{{ filter.min_value.value }}">
                    <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Max €" value="{{ filter.max_value.value }}">
                    <button type="submit" class="btn btn--outline btn--sm">Toepassen</button>
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </form>
        {%- if collection.current_vendor or collection.current_type -%}
          <a href="{{ collection.url }}" class="filter-clear">Filters wissen</a>
        {%- endif -%}
      </aside>

      <div class="collection-main">
        <div class="collection-toolbar">
          <span>{{ paginate.current_offset | plus: 1 }}–{{ paginate.current_offset | plus: collection.products.size }} van {{ collection.products_count }}</span>
          <form action="{{ collection.url }}" method="get" class="collection-sort">
            <label for="sort-by">Sorteren</label>
            <select name="sort_by" id="sort-by" onchange="this.form.submit()">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </form>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="product-grid product-grid--4">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="empty-state">Geen producten gevonden met deze filters.</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Paginering">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Vorige</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Volgende</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Collectiegrid" }
{% endschema %}
