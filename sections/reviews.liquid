{%- liquid
  assign total = 0
  assign count = section.blocks.size
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor
  if count > 0
    assign average = total | divided_by: count | divided_by: 1.0
  else
    assign average = 0
  endif
-%}
<section class="reviews">
  <div class="container">
    <div class="reviews__summary">
      <h2>{{ section.settings.heading }}</h2>
      <div class="reviews__score">
        <span class="reviews__score-number">{{ average | round: 1 }}</span>
        <div class="reviews__stars" aria-hidden="true">
          {%- assign rounded = average | round -%}
          {%- for i in (1..5) -%}
            {%- if i <= rounded -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
          {%- endfor -%}
        </div>
        <span class="reviews__count">{{ count }} reviews</span>
      </div>
      {%- if section.settings.external_link != blank -%}
        <a href="{{ section.settings.external_link }}" class="reviews__external">Alle reviews {% render 'icon', name: 'chevron-right' %}</a>
      {%- endif -%}
    </div>

    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        <div class="review-card">
          <div class="review-card__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
            {%- endfor -%}
          </div>
          <p class="review-card__text">&ldquo;{{ block.settings.text }}&rdquo;</p>
          <p class="review-card__author">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Wat klanten zeggen" },
    { "type": "url", "id": "external_link", "label": "Externe reviewlink (optioneel)" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Score", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Snelle levering en het toestel was precies zoals beschreven." },
        { "type": "text", "id": "author", "label": "Naam", "default": "Klant" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "review" },
      { "type": "review" },
      { "type": "review" }
    ]
  },
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
