<section class="why-us">
  <div class="why-us__grid">
    <div class="why-us__image">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="600" height="{{ 600 | divided_by: section.settings.image.aspect_ratio }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="why-us__content">
      <h2>{{ section.settings.heading }}</h2>
      <div class="why-us__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--cta">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waarom wij",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Wat ons anders maakt" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Elk toestel wordt persoonlijk gecontroleerd op originaliteit en cosmetische staat. Batterijstatus en echte foto's zijn altijd inzichtelijk, zonder verrassingen achteraf.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Ontdek ons proces" },
    { "type": "url", "id": "button_link", "label": "Knoplink" }
  ],
  "presets": [{ "name": "Waarom wij" }]
}
{% endschema %}
