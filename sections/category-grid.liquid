<section class="category-grid">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="category-grid__grid">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ coll.url | default: '#' }}" class="category-card">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title }}" width="350" height="350" loading="lazy">
          {%- elsif coll.featured_image -%}
            <img src="{{ coll.featured_image | image_url: width: 700 }}" alt="{{ block.settings.title }}" width="350" height="350" loading="lazy">
          {%- endif -%}
          <span class="category-card__title">{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Shop op categorie" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "iPhone" },
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel, anders collectiefoto)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "iPhone" } },
      { "type": "category", "settings": { "title": "Apple Watch" } },
      { "type": "category", "settings": { "title": "iPad" } },
      { "type": "category", "settings": { "title": "MacBook" } }
    ]
  },
  "presets": [{ "name": "Categorieën" }]
}
{% endschema %}
