<section class="faq-section">
  <div class="container">
    <h1>{{ section.settings.heading }}</h1>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Veelgestelde vragen" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Hoe wordt de conditie van een toestel bepaald?" },
        { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Elk toestel wordt handmatig gecontroleerd op cosmetische staat, functionaliteit en batterijgezondheid.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "question" },
      { "type": "question" },
      { "type": "question" }
    ]
  },
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
